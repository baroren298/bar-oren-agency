      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.development.local)",
      "Edit(./.env.test)",
      "Edit(./.env.test.local)",
      "Edit(./.env.production)",
      "Edit(./.env.production.local)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(head .env:*)",
      "Bash(head ./.env:*)",
      "Bash(tail .env:*)",
      "Bash(tail ./.env:*)",
      "Bash(cp .env:*)",
      "Bash(cp ./.env:*)",
