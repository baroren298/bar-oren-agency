      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(npx prisma db push)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma db pull)",
      "Bash(npx prisma db pull:*)",
      "Bash(npx prisma db execute)",
      "Bash(npx prisma db execute:*)",
      "Bash(prisma db push)",
      "Bash(prisma db push:*)",
      "Bash(prisma db pull)",
      "Bash(prisma db pull:*)",
      "Bash(prisma db execute)",
      "Bash(prisma db execute:*)",
      "Bash(npx prisma migrate deploy)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(prisma migrate deploy)",
      "Bash(prisma migrate deploy:*)",
      "Bash(psql)",
      "Bash(psql:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(vercel)",
      "Bash(vercel:*)",
      "Bash(npx vercel)",
      "Bash(npx vercel:*)"
