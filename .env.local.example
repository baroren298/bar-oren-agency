# Contact form email delivery
# Add these in Vercel → Project → Settings → Environment Variables

# The email address that receives form submissions
CONTACT_EMAIL=bar@baroren.co.il

# Resend.com API key — https://resend.com (free tier available)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────
# Admin panel (Admin Panel Architecture v1.2) — Phase 1: Foundations
# ─────────────────────────────────────────────────────────────────────────
# Placeholder values only. Do not commit real credentials to this file or
# any other tracked file — real values belong in .env.local (already
# gitignored) or the hosting provider's environment variable settings.
#
# This is infrastructure for the not-yet-built admin panel. The public
# site does not read this variable and is unaffected by its absence.

# Postgres connection string for Prisma (prisma/schema.prisma). Required
# for any admin auth flow (Phase 2 onward) to actually query users.
DATABASE_URL=postgresql://user:password@localhost:5432/bar_oren_admin

# ─────────────────────────────────────────────────────────────────────────
# Admin panel — Phase 2: Auth/Security
# ─────────────────────────────────────────────────────────────────────────
# Placeholder values only — same rule as above, real values never go in
# any committed file.

# Secret used to sign/verify the admin session JWT (lib/admin/auth/session.js).
# Generate a real value with: openssl rand -base64 32
# Rotating this value invalidates every existing admin session.
SESSION_SECRET=replace-with-output-of-openssl-rand-base64-32

# Name of the session cookie. Optional — defaults to "admin_session" if unset.
SESSION_COOKIE_NAME=admin_session

# How long a session stays valid, in seconds. Optional — defaults to 28800 (8h).
SESSION_MAX_AGE_SECONDS=28800

# Login rate limiting (lib/admin/auth/rateLimit.js). Optional — default to
# 5 attempts per 900 seconds (15 min) per IP+email if unset. In-memory for
# v1; see that file's header comment for the known multi-instance caveat.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# No OWNER_EMAIL / OWNER_PASSWORD variables on purpose — the Owner account
# is created with `npm run admin:create-owner` (scripts/create-owner.js),
# which prompts for credentials interactively instead of reading them from
# any .env file.
