# Contact form email delivery
# Add these in Vercel → Project → Settings → Environment Variables

# The email address that receives form submissions
CONTACT_EMAIL=bar@baroren.co.il

# Resend.com API key — https://resend.com (free tier available)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────
# Admin panel (Admin Panel Architecture v1.2) — Phase 1: Foundations
# ─────────────────────────────────────────────────────────────────────────
# Placeholder values only. Do not commit real credentials to this file or
# any other tracked file — real values belong in .env.local (already
# gitignored) or the hosting provider's environment variable settings.
#
# This is infrastructure for the not-yet-built admin panel. The public
# site does not read this variable and is unaffected by its absence.

# Postgres connection string for Prisma (prisma/schema.prisma). Until a
# real database is provisioned, this is unused — no admin code queries it
# yet (Phase 1 ships schema + repository skeletons only, no auth/UI/DB
# wiring).
DATABASE_URL=postgresql://user:password@localhost:5432/bar_oren_admin
